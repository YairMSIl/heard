{
  "name": "heard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.dom.json",
    "db:migrate:local": "wrangler d1 migrations apply heard --local",
    "db:migrate:remote": "wrangler d1 migrations apply heard --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.134.0"
  }
}
