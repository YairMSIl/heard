{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // Worker code only, with Worker types only: reaching for a Node or DOM API
  // that does not exist at runtime fails here rather than in production.
  // Tests are checked by tsconfig.test.json and tsconfig.dom.json.
  "include": ["src/**/*.ts"]
}
