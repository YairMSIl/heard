{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // The Worker runtime has no DOM. test/widget-dom.test.ts runs in jsdom and is
  // checked separately by tsconfig.dom.json, because pulling lib.dom into this
  // config would collide with @cloudflare/workers-types.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/widget-dom.test.ts"]
}
