{
  // Typechecks only the jsdom test, which exercises the widget as a browser
  // would. Separate from tsconfig.json so lib.dom never reaches Worker code.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["test/widget-dom.test.ts", "src/widget.ts"]
}
